# ==========================================================================
# Configuration Apache du site
# ==========================================================================

# Page d'erreur maison pour toute adresse inconnue.
# Chemin depuis la racine du site : à adapter si le site est un jour
# hébergé dans un sous-dossier (comme base_url dans config/site.php).
ErrorDocument 404 /404.php

# Pas de liste des fichiers quand on ouvre un dossier sans index
# (ex. /assets/img/ afficherait sinon tout son contenu).
Options -Indexes

# Dossiers internes : jamais accessibles depuis le navigateur.
# includes/ : morceaux de page qui n'ont pas de sens seuls
# config/   : configuration (identifiants de la base, clé secrète)
# sql/      : structure de la base
# outils/   : scripts de développement (génération des images)
# On répond « 404 » plutôt que « 403 interdit » : inutile de signaler qu'ils existent.
RedirectMatch 404 ^/(includes|config|sql|outils)(/|$)


# ==========================================================================
# Cache du navigateur
# Les CSS, JS et images du site ont un numéro de version dans leur adresse
# (fonctions asset() et image()) : quand un fichier change, son adresse change.
# Le navigateur peut donc les garder un an sans risque de servir une vieille version.
# ==========================================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2|svg|png|jpe?g|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Fichiers appelés par une adresse fixe (sans numéro de version) : une semaine
    <FilesMatch "^(favicon\.(svg|ico)|apple-touch-icon\.png|partage\.jpg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Quelques protections de base
    # nosniff        : le navigateur respecte le type annoncé (un .txt n'est pas exécuté comme script)
    # Referrer-Policy: on ne transmet que le domaine aux sites extérieurs, pas l'adresse complète
    # X-Frame-Options: le site ne peut pas être affiché dans un cadre sur un autre site
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>


# ==========================================================================
# Compression des fichiers texte (HTML, CSS, JS, SVG…) avant l'envoi.
# Les modules ne sont pas activés dans la configuration Apache par défaut de
# Laragon : ces règles s'appliquent seulement là où ils existent (hébergeur).
# ==========================================================================
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
        AddOutputFilterByType DEFLATE application/javascript application/json application/xml
        AddOutputFilterByType DEFLATE image/svg+xml
    </IfModule>
</IfModule>


# ==========================================================================
# HTTPS obligatoire en ligne. Pas en local (adresses en .test, sans certificat).
# X-Forwarded-Proto : certains hébergeurs placent un relais (proxy) devant Apache ;
# sans cette condition, la redirection tournerait en boucle chez eux.
# ==========================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !\.test$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
